{
  "version": 2,
  "id": "default",
  "name": "Site template",
  "conditions": [
    {
      "type": "entireSite",
      "ref": null
    }
  ],
  "css": "[data-bz-node=\"header\"] { position: sticky; top: 0; z-index: 60; border-bottom: 1px solid var(--line); }\n[data-bz-node=\"main-nav\"] .bz-nav > .bz-navitem > a { font-size: 16px; text-transform: uppercase; letter-spacing: .04em; padding-block: var(--space-4); }\n@media (min-width: 1101px) {\n  [data-bz-node=\"main-nav\"] .bz-menu--mega .bz-nav > .bz-navitem--has-sub { position: static; }\n  [data-bz-node=\"main-nav\"] .bz-menu--mega .bz-nav > .bz-navitem--has-sub > .bz-subnav { left: 0; right: 0; width: auto; transform: none; justify-content: center; border-top: 3px solid var(--accent); }\n  [data-bz-node=\"main-nav\"] .bz-subnav .bz-subnav a { font-weight: 500; font-size: 15px; }\n}\n[data-bz-node=\"footer\"] a:not(.bz-btn) { color: rgba(255,255,255,.82); }\n[data-bz-node=\"footer\"] a:not(.bz-btn):hover { color: #fff; }\n@media (max-width: 1100px) {\n  [data-bz-node=\"main-nav\"] .bz-menu-wrap[data-open] > .bz-menu { max-height: calc(100vh - 140px); overflow-y: auto; }\n  [data-bz-node=\"main-nav\"] .bz-nav > .bz-navitem > a { padding-block: var(--space-2); }\n}\n@media (max-width: 640px) {\n  [data-bz-node=\"logo\"] .bz-logo__img { height: 34px; }\n}",
  "js": "",
  "nodes": [
    {
      "id": "utility",
      "type": "sharedSection",
      "props": {
        "sectionId": "utility-bar",
        "values": {}
      }
    },
    {
      "id": "header",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 0,
        "background": "card"
      },
      "children": [
        {
          "id": "header-row",
          "type": "row",
          "props": {
            "gap": 5,
            "align": "center",
            "stackOn": "never"
          },
          "children": [
            {
              "id": "header-brand",
              "type": "column",
              "props": {
                "span": 3,
                "align": "center"
              },
              "children": [
                {
                  "id": "logo",
                  "type": "logo",
                  "props": {
                    "url": "/",
                    "height": 44,
                    "image": {
                      "src": "/logo.svg",
                      "alt": "BuzzNerd Trucks",
                      "width": 360,
                      "height": 72
                    }
                  }
                }
              ],
              "styles": {
                "tablet": {
                  "flexGrow": 1
                }
              }
            },
            {
              "id": "header-nav",
              "type": "column",
              "props": {
                "span": 7,
                "align": "center"
              },
              "children": [
                {
                  "id": "main-nav",
                  "type": "menu",
                  "props": {
                    "menuId": "main",
                    "layout": "mega",
                    "align": "center",
                    "collapseOnMobile": true
                  }
                }
              ],
              "styles": {
                "tablet": {
                  "order": 3,
                  "flexGrow": 0
                }
              }
            },
            {
              "id": "header-cta",
              "type": "column",
              "props": {
                "span": 2,
                "align": "center"
              },
              "children": [
                {
                  "id": "header-button",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "browse-inventory",
                        "label": "Inventory"
                      }
                    ],
                    "align": "left"
                  }
                }
              ],
              "styles": {
                "tablet": {
                  "order": 2
                }
              }
            }
          ],
          "styles": {
            "tablet": {
              "display": "flex",
              "alignItems": "center",
              "justifyContent": "between",
              "gap": 12,
              "paddingTop": 10,
              "paddingBottom": 10
            }
          }
        }
      ]
    },
    {
      "id": "content",
      "type": "contentArea",
      "props": {
        "label": "Page content"
      }
    },
    {
      "id": "site-footer",
      "type": "sharedSection",
      "props": {
        "sectionId": "site-footer",
        "values": {
          "linkColumns": [
            {
              "heading": "Trucks",
              "menuId": "footer-trucks"
            },
            {
              "heading": "Parts & Service",
              "menuId": "footer-service"
            },
            {
              "heading": "Company",
              "menuId": "footer-company"
            }
          ]
        }
      }
    }
  ]
}
