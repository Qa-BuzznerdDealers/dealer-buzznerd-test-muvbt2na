{
  "version": 2,
  "nodes": [
    {
      "id": "contact-head",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 7
      },
      "children": [
        {
          "id": "contact-head-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "contact-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "contact-h1",
                  "type": "heading",
                  "props": {
                    "text": "Contact us",
                    "eyebrow": "We are here to help",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "contact-intro",
                  "type": "text",
                  "props": {
                    "text": "Sales, parts or service — send us a message, call, or visit the location nearest you."
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "contact-main",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "contact-main-row",
          "type": "row",
          "props": {
            "gap": 5,
            "stackOn": "tablet"
          },
          "children": [
            {
              "id": "contact-form-col",
              "type": "column",
              "props": {
                "span": 7,
                "background": "card",
                "padding": 6
              },
              "styles": {
                "base": {
                  "radius": 6,
                  "shadow": "md"
                }
              },
              "children": [
                {
                  "id": "contact-form",
                  "type": "form",
                  "props": {
                    "formId": "request-info",
                    "heading": "Send us a message",
                    "headingLevel": 2
                  }
                }
              ]
            },
            {
              "id": "contact-side",
              "type": "column",
              "props": {
                "span": 5
              },
              "children": [
                {
                  "id": "contact-phones",
                  "type": "widget",
                  "props": {
                    "widget": "phone-numbers"
                  }
                },
                {
                  "id": "contact-hours",
                  "type": "widget",
                  "props": {
                    "widget": "hours",
                    "config": {
                      "heading": "Hours"
                    }
                  }
                },
                {
                  "id": "contact-buttons",
                  "type": "buttons",
                  "props": {
                    "items": [
                      {
                        "ctaId": "call-us"
                      },
                      {
                        "ctaId": "find-location"
                      }
                    ]
                  }
                }
              ]
            }
          ],
          "styles": {
            "base": {
              "columnGap": 56
            },
            "tablet": {
              "columnGap": 0
            }
          }
        }
      ]
    },
    {
      "id": "contact-map-sec",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "paper",
        "paddingY": 7
      },
      "children": [
        {
          "id": "contact-map-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "contact-map-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "contact-map",
                  "type": "widget",
                  "props": {
                    "widget": "locations-map",
                    "config": {
                      "heading": "Visit a location",
                      "showMap": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
