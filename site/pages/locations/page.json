{
  "version": 2,
  "nodes": [
    {
      "id": "loc-head",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 7
      },
      "children": [
        {
          "id": "loc-head-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "loc-head-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "loc-h1",
                  "type": "heading",
                  "props": {
                    "text": "Find a location",
                    "eyebrow": "Sales · Parts · Service",
                    "headingLevel": 1
                  }
                },
                {
                  "id": "loc-intro",
                  "type": "text",
                  "props": {
                    "text": "Every location offers parts and service, and most offer new and used truck sales. Choose a location for hours, phone numbers and directions."
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "loc-map-sec",
      "type": "section",
      "props": {
        "width": "boxed",
        "paddingY": 7
      },
      "children": [
        {
          "id": "loc-map-row",
          "type": "row",
          "props": {},
          "children": [
            {
              "id": "loc-map-col",
              "type": "column",
              "props": {
                "span": 12
              },
              "children": [
                {
                  "id": "loc-map",
                  "type": "widget",
                  "props": {
                    "widget": "locations-map",
                    "config": {
                      "heading": "Our locations",
                      "showMap": true
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "loc-cards",
      "type": "sharedSection",
      "props": {
        "sectionId": "location-cards",
        "values": {
          "heading": "All locations",
          "locations": {
            "source": "locations",
            "config": {
              "pagePathPrefix": "/locations"
            }
          }
        }
      }
    },
    {
      "id": "loc-cta",
      "type": "sharedSection",
      "props": {
        "sectionId": "cta-band",
        "values": {
          "heading": "Broken down?",
          "body": "Call us and we will get the nearest service team moving.",
          "ctaLabel": "Contact us",
          "ctaUrl": "/contact"
        }
      }
    }
  ]
}
