{
  "$schema": "./tokens.schema.json",
  "version": 2,
  "fonts": {
    "heading": "Barlow Condensed",
    "body": "Barlow",
    "files": []
  },
  "colors": {
    "accent": "#DC2626",
    "accentDark": "#B91C1C",
    "ink": "#0F172A",
    "inkDark": "#0b0d10",
    "muted": "#646b76",
    "line": "#dde1e6",
    "card": "#ffffff",
    "paper": "#f2f3f5"
  },
  "status": {
    "ok": "#2f6b45",
    "info": "#2f5ea8",
    "warn": "#b5761f",
    "bad": "#b03a32"
  },
  "typography": {
    "headingWeight": 700,
    "bodyWeight": 400,
    "headingLineHeight": 1.05,
    "bodyLineHeight": 1.6
  },
  "type": {
    "h1": 60,
    "h2": 40,
    "h3": 24,
    "body": 17,
    "small": 15,
    "eyebrow": 13
  },
  "spacing": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 56 },
  "radius": { "nav": 4, "input": 4, "card": 6, "modal": 10, "chip": 999 },
  "layout": { "container": "1240px" }
}
